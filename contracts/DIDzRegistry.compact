pragma language_version >= 0.16 && <= 0.23;

import CompactStandardLibrary;

// ===== DIDzRegistry v2: machine (1) — minting permanent DIDz identities =====
//
// WHAT THIS CONTRACT IS
//   The root identity layer of the three-pillar architecture. Machine (1):
//   it MINTS permanent identities. Machine (2) — scoped-grant in
//   midnight-modules — moves authority around; this contract never does.
//
// THE RULES THIS CONTRACT ENFORCES (John's rulings, July 2026)
//   1. NOT A TOKEN. A DIDz is a registry entry. There is NO transfer circuit —
//      identity is non-transferable BY CONSTRUCTION. Keys rotate and recover;
//      the identity itself never moves and is NEVER deleted.
//   2. PERMANENT IDENTITY, TEMPORARY ELIGIBILITY. A DIDz never expires; what
//      expires is eligibility (POL credential, attestations). Death/dissolution
//      /destruction are STATUSES on the permanent record, not deletion.
//   3. PRIVATE BY DEFAULT, PROVABLE ON DEMAND — as much as is reasonable.
//      Public on-chain:   that a DIDz exists, and its lifecycle status.
//                         (Verifiers genuinely need these two bits, and they
//                         reveal nothing about WHO or WHAT the entity is.)
//      Committed (hidden): entity type, subject binding, owner key, every
//                         attestation's content and issuer. Each has a ZK
//                         circuit to prove exactly one fact when the HOLDER
//                         chooses to share it, and nothing otherwise.
//
// LIFECYCLE STATUS TABLE (public, one Uint<8> per DIDz)
//   0 = active      normal operation
//   1 = suspended   owner paused it — the ONLY reversible non-active status
//   2 = deceased    human died      — TERMINAL (authoritative human source is
//                                     midnight-modules/pol-credential; the SDK
//                                     bridges the two until cross-contract
//                                     calls exist)
//   3 = dissolved   org wound down  — TERMINAL
//   4 = destroyed   object scrapped — TERMINAL (mirrors RWAz retire_object)
//
// WHO CALLS WHAT (call map for debugging)
//   register_did          <- any wallet (mints; caller's key becomes owner)
//   assert_i_control      <- the owner: ZK "I control this live DIDz"
//   prove_entity_type     <- the owner: opt-in reveal of ONE fact (the type)
//   rotate_owner_key      <- the owner (old key authorizes the new one)
//   suspend_did           <- the owner        (status 0 -> 1)
//   reactivate_did        <- the owner        (status 1 -> 0; terminals never)
//   set_terminal_status   <- the owner OR a registered status authority
//                            (death-certificate / dissolution flows)
//   add_status_authority  <- the deployer admin, once per authority
//   attest_to_did         <- any issuer (trust is the verifier's judgment via
//                            TrustedIssuerRegistry)
//   revoke_attestation    <- the SAME issuer that made it
//   prove_attestation     <- the SUBJECT's owner: opt-in one-bit reveal that a
//                            specific attestation commitment is live + unexpired
//   derive_pairwise_did   <- wallets, pure helper (ruling 4: pairwise DIDs)
//   prove_pairwise_binding<- the owner: opt-in accountability reveal linking
//                            a pairwise DID back to their canonical DIDz
//   advance_epoch         <- keeper/cron (shared clock pattern)
//   derive_public_key     <- SDKs, pure helper
//
// WHAT PLUGS IN (ecosystem breadcrumbs)
//   AgenticDID  -> agents anchor here, authority via scoped-grant v2
//   RWAz        -> objects anchor here, titles move in rwa_registry
//   KYCz        -> issuers attest KYC tiers as commitments here
//   pol-credential -> liveness for humans; feeds status 2 via authorities
//   selectConnect / ProMingle / SouLink / realVote -> consume the proofs

// ---------------------------------------------------------------------------
// PUBLIC STATE (deliberately minimal — rule 3)
// ---------------------------------------------------------------------------

// Every DIDz ever minted. NOTHING is ever removed from this set (rule 2).
export ledger dids: Set<Bytes<32>>;

// didId -> lifecycle status (see table). The only other public fact.
export ledger did_status: Map<Bytes<32>, Uint<8>>;

// didId -> commitment binding this DIDz to its PRIVATE profile:
//   H("didz:profile:v2", entityType, subjectCommitment, profileSalt)
// entity type, subject binding, and salt live with the holder off-chain;
// prove_entity_type re-derives this in-circuit for selective reveal.
export ledger did_profile_commitment: Map<Bytes<32>, Bytes<32>>;

// didId -> key COMMITMENT of the current owner (engine pattern — the raw
// public key is never stored; control is proven in zero knowledge).
export ledger did_owner: Map<Bytes<32>, Bytes<32>>;

// Attestation slot key H("didz:attest:v2", didId, attestationType) -> the
// attestation's content commitment. The type itself is already a hash, so
// even the KIND of attestation is only discoverable by someone who knows
// what to ask for.
export ledger attestation_commitment: Map<Bytes<32>, Bytes<32>>;

// slot key -> issuer key commitment (for revocation auth + issuer proofs).
export ledger attestation_issuer: Map<Bytes<32>, Bytes<32>>;

// slot key -> expiry epoch. Max Uint<64> = never expires.
export ledger attestation_expiry: Map<Bytes<32>, Uint<64>>;

// slot key -> revoked flag (slots are never deleted — audit trail, rule 2).
export ledger attestation_revoked: Map<Bytes<32>, Boolean>;

// Key commitments allowed to set TERMINAL statuses besides the owner
// (e.g. a vital-records authority filing a death certificate).
export ledger status_authorities: Set<Bytes<32>>;

// The deployer-admin's key commitment (manages status_authorities only).
export ledger registry_admin: Bytes<32>;
export ledger registry_admin_claimed: Boolean;

// Public health metrics (aggregate counters leak no individual facts).
export ledger total_dids_minted: Counter;

// Keeper-driven clock (same pattern as every engine module).
export ledger epoch: Counter;

// ---------------------------------------------------------------------------
// PRIVATE INPUTS
// ---------------------------------------------------------------------------

// The caller's secret key (owner / issuer / authority / admin by context).
witness local_secret_key(): Bytes<32>;

// ---------------------------------------------------------------------------
// HELPERS
// ---------------------------------------------------------------------------

// Shared key derivation across the whole DIDz engine (same domain tag).
export circuit derive_public_key(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "midnight:mm:pk:"),
    sk
  ]);
}

circuit caller_public_key(): Bytes<32> {
  return derive_public_key(local_secret_key());
}

// The private-profile commitment (exported pure so wallets can precompute it,
// and so prove_entity_type can re-derive it for the selective reveal).
export circuit derive_profile_commitment(
  entity_type: Uint<8>,
  subject_commitment: Bytes<32>,
  profile_salt: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "didz:profile:v2"),
    persistentHash<Uint<8>>(entity_type),
    subject_commitment,
    profile_salt
  ]);
}

// Composite key for one attestation slot: H(domain, didId, type).
circuit attestation_slot(did_id: Bytes<32>, attestation_type: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "didz:attest:v2"),
    did_id,
    attestation_type
  ]);
}

// Shared guard: the DIDz exists, is ACTIVE (status 0), and the caller
// proves ownership. Every owner-authorized circuit funnels through here.
circuit check_caller_owns_active_did(did_id: Bytes<32>): [] {
  assert(dids.member(did_id), "DIDz not found");
  assert(did_status.lookup(did_id) == 0, "DIDz is not active");
  assert(
    disclose(caller_public_key() == did_owner.lookup(did_id)),
    "Caller does not control this DIDz"
  );
}

// ---------------------------------------------------------------------------
// ADMIN: one-shot claim + terminal-status authorities
// ---------------------------------------------------------------------------

export circuit claim_registry_admin(): [] {
  assert(!registry_admin_claimed, "Registry admin already claimed");
  registry_admin = disclose(caller_public_key());
  registry_admin_claimed = true;
}

// Enroll an authority allowed to file terminal statuses (vital records
// office, corporate registrar, salvage authority...).
export circuit add_status_authority(authority_public_key: Bytes<32>): [] {
  assert(disclose(caller_public_key() == registry_admin), "Not the registry admin");
  status_authorities.insert(disclose(authority_public_key));
}

export circuit remove_status_authority(authority_public_key: Bytes<32>): [] {
  assert(disclose(caller_public_key() == registry_admin), "Not the registry admin");
  status_authorities.remove(disclose(authority_public_key));
}

// ---------------------------------------------------------------------------
// MINT: register a permanent DIDz
// ---------------------------------------------------------------------------
// The did_id is caller-supplied (e.g. H(profile commitment, nonce) computed
// in the wallet) and must be unique. The caller's key commitment becomes the
// owner. Only TWO public facts appear: the id exists, and it is active.
export circuit register_did(
  did_id: Bytes<32>,
  profile_commitment: Bytes<32>
): [] {
  const public_did_id = disclose(did_id);
  assert(!dids.member(public_did_id), "DIDz id already exists");

  dids.insert(public_did_id);
  did_status.insert(public_did_id, 0);                       // born active
  did_profile_commitment.insert(public_did_id, disclose(profile_commitment));
  did_owner.insert(public_did_id, disclose(caller_public_key()));
  total_dids_minted.increment(1);
}

// ---------------------------------------------------------------------------
// SELECTIVE PROOFS (rule 3: prove one fact, only when the holder chooses)
// ---------------------------------------------------------------------------

// ZK proof of control: "I control this DIDz and it is active." One bit out.
export circuit assert_i_control(did_id: Bytes<32>): [] {
  check_caller_owns_active_did(disclose(did_id));
}

// Opt-in reveal of exactly ONE private fact: the entity type. The owner
// supplies the private profile pieces; the circuit re-derives the stored
// commitment, proving the claimed type is the real one — without ever
// putting the subject binding or salt on-chain.
export circuit prove_entity_type(
  did_id: Bytes<32>,
  claimed_entity_type: Uint<8>,
  subject_commitment: Bytes<32>,
  profile_salt: Bytes<32>
): [] {
  const public_did_id = disclose(did_id);
  check_caller_owns_active_did(public_did_id);
  assert(
    disclose(
      derive_profile_commitment(claimed_entity_type, subject_commitment, profile_salt)
        == did_profile_commitment.lookup(public_did_id)
    ),
    "Profile does not match this DIDz"
  );
  // Landing here proves: caller controls the DIDz AND its committed profile
  // really carries claimed_entity_type. The claimed type is the disclosure.
  const revealed_type = disclose(claimed_entity_type);
}

// ---------------------------------------------------------------------------
// KEY ROTATION (W3C DID §9.9) — identity stays, the key moves
// ---------------------------------------------------------------------------
export circuit rotate_owner_key(
  did_id: Bytes<32>,
  new_owner_public_key: Bytes<32>
): [] {
  const public_did_id = disclose(did_id);
  check_caller_owns_active_did(public_did_id);
  const public_new_owner = disclose(new_owner_public_key);
  assert(public_new_owner != pad(32, ""), "New owner key cannot be zero");
  did_owner.insert(public_did_id, public_new_owner);
}

// ---------------------------------------------------------------------------
// LIFECYCLE (rule 2: statuses move, the record never disappears)
// ---------------------------------------------------------------------------

// Owner pauses their own DIDz (0 -> 1). The only reversible pause.
export circuit suspend_did(did_id: Bytes<32>): [] {
  const public_did_id = disclose(did_id);
  check_caller_owns_active_did(public_did_id);
  did_status.insert(public_did_id, 1);
}

// Owner un-pauses (1 -> 0). Terminal statuses can never come back this way.
export circuit reactivate_did(did_id: Bytes<32>): [] {
  const public_did_id = disclose(did_id);
  assert(dids.member(public_did_id), "DIDz not found");
  assert(did_status.lookup(public_did_id) == 1, "DIDz is not suspended");
  assert(
    disclose(caller_public_key() == did_owner.lookup(public_did_id)),
    "Caller does not control this DIDz"
  );
  did_status.insert(public_did_id, 0);
}

// File a TERMINAL status (2 deceased / 3 dissolved / 4 destroyed).
// Allowed: the owner (self-report, e.g. an org winding itself down) OR a
// registered status authority (death-certificate flow). IRREVERSIBLE.
export circuit set_terminal_status(did_id: Bytes<32>, new_status: Uint<8>): [] {
  const public_did_id = disclose(did_id);
  const public_status = disclose(new_status);
  assert(dids.member(public_did_id), "DIDz not found");
  assert(public_status >= 2 && public_status <= 4, "Not a terminal status");
  const current = did_status.lookup(public_did_id);
  assert(current <= 1, "DIDz already in a terminal status");
  // The caller's key commitment is disclosed once, then checked against both
  // authorization paths (ledger-op arguments must be disclosed values).
  const caller = disclose(caller_public_key());
  assert(
    caller == did_owner.lookup(public_did_id)
      || status_authorities.member(caller),
    "Caller is neither the owner nor a status authority"
  );
  did_status.insert(public_did_id, public_status);
}

// ---------------------------------------------------------------------------
// ATTESTATIONS (contents committed; existence discoverable only by type)
// ---------------------------------------------------------------------------

// An issuer attests something about a DIDz. Content stays off-chain; only
// its commitment lands here. Slot rules: one live attestation per
// (DIDz, type); the SAME issuer may refresh; a different issuer must wait
// for revocation (prevents slot hijack). Pass max Uint<64> for "no expiry".
export circuit attest_to_did(
  did_id: Bytes<32>,
  attestation_type: Bytes<32>,
  content_commitment: Bytes<32>,
  expiry_epoch: Uint<64>
): [] {
  const public_did_id = disclose(did_id);
  assert(dids.member(public_did_id), "DIDz not found");
  assert(did_status.lookup(public_did_id) == 0, "DIDz is not active");

  const slot = attestation_slot(public_did_id, disclose(attestation_type));
  const issuer = disclose(caller_public_key());
  // A live slot may only be refreshed by its own issuer.
  assert(
    !attestation_commitment.member(slot)
      || attestation_revoked.lookup(slot)
      || attestation_issuer.lookup(slot) == issuer,
    "Slot held by a different issuer - needs revocation first"
  );

  attestation_commitment.insert(slot, disclose(content_commitment));
  attestation_issuer.insert(slot, issuer);
  attestation_expiry.insert(slot, disclose(expiry_epoch));
  attestation_revoked.insert(slot, false);
}

// The issuing issuer (and only them) revokes their attestation.
export circuit revoke_attestation(
  did_id: Bytes<32>,
  attestation_type: Bytes<32>
): [] {
  const slot = attestation_slot(disclose(did_id), disclose(attestation_type));
  assert(attestation_commitment.member(slot), "Attestation not found");
  assert(!attestation_revoked.lookup(slot), "Attestation already revoked");
  assert(
    disclose(caller_public_key() == attestation_issuer.lookup(slot)),
    "Only the issuing issuer can revoke"
  );
  attestation_revoked.insert(slot, true);
}

// SELECTIVE PROOF: the subject's owner proves "this DIDz carries a live,
// unexpired attestation of this type matching this exact content commitment."
// The verifier already holds the claimed commitment off-chain (the holder
// shared the claim data with them); the chain confirms it, one bit out.
export circuit prove_attestation(
  did_id: Bytes<32>,
  attestation_type: Bytes<32>,
  claimed_content_commitment: Bytes<32>
): [] {
  const public_did_id = disclose(did_id);
  check_caller_owns_active_did(public_did_id);
  const slot = attestation_slot(public_did_id, disclose(attestation_type));
  assert(attestation_commitment.member(slot), "Attestation not found");
  assert(!attestation_revoked.lookup(slot), "Attestation revoked");
  assert(epoch.read() < attestation_expiry.lookup(slot), "Attestation expired");
  assert(
    attestation_commitment.lookup(slot) == disclose(claimed_content_commitment),
    "Content commitment does not match"
  );
}

// ---------------------------------------------------------------------------
// PAIRWISE PRESENTATION DIDs (John's ruling 4)
// ---------------------------------------------------------------------------
// THE RULE: one CANONICAL DIDz per entity (the accountability anchor — it is
// NEVER put on the wire), plus a different PAIRWISE DID for every
// counterparty you deal with (anti-collusion: two services comparing notes
// see two unrelated identifiers and cannot link you across them).
//
// HOW IT WORKS HERE
//   1. Pairwise DIDs are DERIVED, not registered. The wallet computes
//        pairwise = H("didz:pairwise:v1", canonical, counterparty_context, salt)
//      with derive_pairwise_did and hands it to ONE counterparty. NOTHING is
//      written on-chain — an on-chain register would itself be a linkage
//      trail. No state, no linkage. Day-to-day, the counterparty just uses
//      the pairwise DID with off-chain signatures.
//   2. ACCOUNTABILITY REVEAL (opt-in, the whole point of the anchor): if the
//      holder must prove "this pairwise DID is really me" — to a court, an
//      auditor, or a counterparty upgrading the relationship — they run
//      prove_pairwise_binding. It re-derives the pairwise from the canonical
//      in-circuit AND proves they control that canonical and it is ACTIVE.
//      Disclosing the canonical to THAT verifier is deliberate: this circuit
//      IS the moment of chosen accountability (rule 3: reveal on demand).
//
// HONEST LIMIT (v1): there is no circuit proving "this pairwise DID belongs
// to SOME active DIDz" without naming which — that needs a Merkle
// accumulator over the registry (planned; noted in contracts/README). Until
// then: everyday use = off-chain, reveal = prove_pairwise_binding.

// Pure derivation shared by wallets and prove_pairwise_binding.
//   counterparty_context: an agreed label for the relationship, e.g.
//     H("acme-corp.com") — same context every session, same pairwise DID.
//   pairwise_salt: random per relationship, kept by the holder. Without it,
//     a counterparty who guesses your canonical could brute-force the link.
export circuit derive_pairwise_did(
  canonical_did_id: Bytes<32>,
  counterparty_context: Bytes<32>,
  pairwise_salt: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "didz:pairwise:v1"),
    canonical_did_id,
    counterparty_context,
    pairwise_salt
  ]);
}

// OPT-IN accountability reveal: "pairwise DID P (which you already know)
// belongs to canonical DIDz C (revealed to you now), and I control C, and C
// is active." The verifier learns the canonical — by the holder's choice.
export circuit prove_pairwise_binding(
  pairwise_did: Bytes<32>,
  canonical_did_id: Bytes<32>,
  counterparty_context: Bytes<32>,
  pairwise_salt: Bytes<32>
): [] {
  // The canonical is the deliberate disclosure of this circuit (see header).
  const public_canonical = disclose(canonical_did_id);
  // 1. Caller really controls that canonical DIDz and it is live.
  check_caller_owns_active_did(public_canonical);
  // 2. The pairwise DID really derives from it (context + salt stay private;
  //    only the yes/no of the match is revealed).
  assert(
    disclose(
      derive_pairwise_did(canonical_did_id, counterparty_context, pairwise_salt)
        == pairwise_did
    ),
    "Pairwise DID does not derive from this canonical DIDz"
  );
}

// ---------------------------------------------------------------------------
// CLOCK
// ---------------------------------------------------------------------------
export circuit advance_epoch(): [] {
  epoch.increment(1);
}
